          "rawQuery": true,
          "rawSql": "WITH last_1000 AS (\n    SELECT *\n    FROM fraud_scores\n    ORDER BY created_at DESC\n    LIMIT 1000\n)\nSELECT\n    cat_id::text AS cat_id,\n    ROUND((AVG(fraud_flag::float) * 100)::numeric, 2) AS fraud_share_percent\nFROM last_1000\nWHERE cat_id IS NOT NULL\nGROUP BY cat_id\nORDER BY fraud_share_percent DESC\nLIMIT 20;",
